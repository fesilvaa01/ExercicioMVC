@model PrimeiroProjetoMVC.ViewModels.BuscaEventoViewModel

@{
    ViewData["Title"] = "Buscar Eventos";
}

<h2>Buscar Eventos</h2>
<hr />

<form asp-action="Buscar" method="post" class="card p-3 mb-4 bg-light">
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="NomeBusca" class="form-label"></label>
            <input asp-for="NomeBusca" class="form-control" placeholder="Digite o nome do evento..." />
        </div>
        <div class="col-md-4">
            <label asp-for="LocalBusca" class="form-label"></label>
            <input asp-for="LocalBusca" class="form-control" placeholder="Digite o local..." />
        </div>
        <div class="col-md-4">
            <label asp-for="DataInicial" class="form-label"></label>
            <input asp-for="DataInicial" class="form-control" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Pesquisar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Ver Todos</a>
    </div>
</form>

@if (Model.PesquisaRealizada)
{
    if (!Model.Resultados.Any())
    {
        <div class="alert alert-warning">
            Nenhum evento foi encontrado com os critérios informados.
        </div>
    }
    else
    {
        <h4>Resultados Encontrados (@Model.Resultados.Count)</h4>
        <table class="table table-bordered table-hover mt-2">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>Local</th>
                    <th>Data</th>
                    <th>Quantidade de Vagas</th>
                    <th>Valor do Ingresso</th>
                    <th>Detalhes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evento in Model.Resultados)
                {
                    <tr>
                        <td>@evento.Nome</td>
                        <td>@evento.Local</td>
                        <td>@evento.DataEvento.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@evento.QuantidadeVagas</td>
                        <td>@evento.ValorIngresso.ToString("C")</td>
                        <td>
                            <a asp-action="Detalhes" asp-route-id="@evento.Id" class="btn btn-sm btn-info text-white">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}